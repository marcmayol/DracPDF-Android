root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
# Los composables van en PascalCase: es la convención de Compose, no un descuido.
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_function-naming = enabled

[*.{xml,yml,yaml,json}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
