<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Sin permisos peligrosos. Los ficheros se abren siempre por Storage Access
        Framework, que concede el acceso documento a documento: ni
        READ_EXTERNAL_STORAGE ni MANAGE_EXTERNAL_STORAGE.
    -->

    <application
        android:allowBackup="true"
        android:label="@string/app_nombre"
        android:supportsRtl="true"
        android:theme="@style/Theme.DracPDF">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_nombre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
