<?xml version="1.0" encoding="utf-8"?>
<!--
    Icono adaptativo, montado con las tres capas que entrega el diseño: fondo rojo
    brasa plano, dragón en tinta y silueta monocroma para los iconos temáticos de
    Android 13+. El dragón va inscrito en la zona segura, con margen de sobra para
    que ningún cuerno se pierda en el recorte circular.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
