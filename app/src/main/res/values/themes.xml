<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema de arranque, no el de la aplicación: Compose pinta el suyo (tema Ladón)
        en cuanto la actividad crea su contenido. Este sólo evita el destello blanco
        del sistema antes del primer frame, así que su fondo es el canvas oscuro.
    -->
    <style name="Theme.DracPDF" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_oscuro</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
